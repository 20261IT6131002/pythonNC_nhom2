# Export these variables in your shell; the app does not auto-load .env files.
NOTEAPP_MONGO_URI=mongodb://127.0.0.1:27017
NOTEAPP_DB_NAME=noteapp_dev
NOTEAPP_MONGO_TIMEOUT_MS=3000
# Tests generate and clean up their own noteapp_test_* database.
NOTEAPP_TEST_MONGO_URI=mongodb://127.0.0.1:27017
# NOTEAPP_TEST_DB_NAME=noteapp_test_local
# CI enables this to fail rather than skip when Mongo is unavailable.
NOTEAPP_REQUIRE_MONGO=0
# Optional IANA timezone override; otherwise tzlocal resolves the OS zone.
# NOTEAPP_TIMEZONE=Asia/Ho_Chi_Minh
# Enable only after retention safety review; default is disabled.
NOTEAPP_ENABLE_RETENTION=0
